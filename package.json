{
  "name": "link-to-qr",
  "version": "1.0.0",
  "description": "Modern, elegant QR Code generator with real-time preview, custom gradients, logos, and high-res exports",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "docker:build": "docker build -t qr-studio .",
    "docker:run": "docker run -d -p 8080:80 --name qr-studio qr-studio",
    "docker:compose": "docker compose up -d"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "qr-code-styling": "^1.6.0-rc.1"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "vite": "^6.0.0"
  }
}
